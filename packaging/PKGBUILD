# Maintainer: Mei <notth4tcold@gmail.com>
# Build from the repository checkout: cd packaging && makepkg -si
pkgname=undercovernc
pkgver=0.1.1
pkgrel=1
pkgdesc="Impressão de capas de CD/DVD/Blu-ray no tamanho exato, inspirado no UnderCoverXP"
url="https://github.com/notth4tcold/UnderCoverNc"
arch=('x86_64' 'aarch64')
license=('MIT' 'OFL-1.1')
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'wayland' 'libglvnd' 'xdg-desktop-portal' 'cups' 'hicolor-icon-theme')
optdepends=('xdg-desktop-portal-gtk: janelas de abrir/salvar arquivos'
            'xdg-desktop-portal-kde: janelas de abrir/salvar arquivos (KDE)'
            'system-config-printer: botão "Impressoras do sistema"')
makedepends=('cargo')
source=()
options=('!lto' '!debug')

_root() { realpath "$startdir/.."; }

prepare() {
  cd "$(_root)"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$(_root)"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release
}

check() {
  cd "$(_root)"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release
}

package() {
  cd "$(_root)"
  install -Dm755 "$srcdir/target/release/undercovernc" "$pkgdir/usr/bin/undercovernc"
  install -Dm644 packaging/undercovernc.desktop "$pkgdir/usr/share/applications/undercovernc.desktop"
  install -Dm644 packaging/undercovernc.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/undercovernc.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 assets/VT323-OFL.txt "$pkgdir/usr/share/licenses/$pkgname/VT323-OFL.txt"
}
